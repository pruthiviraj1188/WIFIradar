# WiFi-Radar Environment Configuration

# Project Configuration
PROJECT_NAME=WiFi-Radar
ENVIRONMENT=development

# Dataset Paths
DATASETS_RAW_DIR=./datasets/raw
DATASETS_PROCESSED_DIR=./datasets/processed
DATASETS_METADATA_DIR=./datasets/metadata

# Model Configuration
MODEL_SAVE_DIR=./ai/saved_models
MODEL_CHECKPOINT_DIR=./ai/saved_models/checkpoints

# Data Collection
CSI_RECEIVER_PORT=/dev/ttyUSB0
CSI_BAUD_RATE=115200
RECORDINGS_DIR=./data_collection/recordings

# Database (for future phases)
DATABASE_URL=sqlite:///./wifi_radar.db
# DATABASE_URL=postgresql://user:password@localhost/wifi_radar

# Backend API (for future phases)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# WebSocket
WS_PORT=8001

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/wifi_radar.log

# Security (for future phases)
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Notification Services (for future phases)
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_API_KEY=your-api-key

# Frontend (for future phases)
FRONTEND_URL=http://localhost:3000

# HuggingFace
HF_TOKEN=  # Optional: for private datasets
